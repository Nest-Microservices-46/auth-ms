# Solo para correr el servicio a mano fuera de Docker.
#   cp .env.template .env

# Validado por Joi pero no se escucha en ningun puerto: auth-ms habla solo NATS.
PORT=3004

NATS_SERVERS=nats://localhost:4222

# Con el que se firman y verifican los JWT. Tiene que ser el mismo del .env raiz.
JWT_SECRET=cambiame_por_un_secreto_largo

# MongoDB. NO esta en el schema de Joi, pero Prisma la necesita igual.
# Atlas, o un contenedor local: mongodb://localhost:27017/AuthDB
DATABASE_URL=mongodb+srv://usuario:password@cluster.mongodb.net/AuthDB
